          "stringUnit": {
            "state": "translated",
            "value": "Select your bank from the home screen or side menu. You will see operations organized by categories: Session, Inquiries, Transfers, etc. Tapping any operation opens the phone dialer with the USSD code ready. Just confirm the call."
          }
        },
